# Shared Sanity configuration
NEXT_PUBLIC_SANITY_PROJECT_ID="your-project-id"
NEXT_PUBLIC_SANITY_DATASET="production"
NEXT_PUBLIC_SANITY_API_VERSION="2026-07-05"

# Sanity Studio also accepts its native env names.
SANITY_STUDIO_PROJECT_ID="your-project-id"
SANITY_STUDIO_DATASET="production"

# Required for Sanity Live Content API and draft/preview workflows.
SANITY_API_READ_TOKEN=""
SANITY_REVALIDATE_SECRET=""

# Optional site metadata
NEXT_PUBLIC_SITE_URL="http://localhost:3000"
